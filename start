#!/bin/bash
set -e
cd "$(dirname "$0")"

echo "Installing Python dependencies..."
python -m pip install -r requirements.txt -q

echo "Installing Playwright's browser (needed by 3 of the tools)..."
python -m playwright install chromium

# Get this folder's path in normal Windows form (C:\Users\...) so it can be
# added to the Windows PATH, not the /c/Users/... form bash itself uses.
WIN_DIR="$(pwd -W 2>/dev/null | sed 's#/#\\#g')"
if [ -z "$WIN_DIR" ]; then
    WIN_DIR="$(pwd)"
fi

echo "Adding Argus to your PATH so 'argus' works from any folder..."
powershell.exe -NoProfile -Command "
  \$dir = '$WIN_DIR'
  \$old = [Environment]::GetEnvironmentVariable('PATH','User')
  if (\$old -notlike \"*\$dir*\") {
      [Environment]::SetEnvironmentVariable('PATH', \"\$old;\$dir\", 'User')
      Write-Output 'PATH updated.'
  } else {
      Write-Output 'Already in PATH.'
  }
"

echo "done" > .argus_setup_ok

echo ""
echo "Setup complete."
echo "Close this terminal and open a NEW one, then just type: argus"
